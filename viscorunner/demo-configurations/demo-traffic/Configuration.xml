<!DOCTYPE Configuration [
        <!ENTITY traffic-generator SYSTEM "Configuration-traffic-generator.xml">
        ]>

<Configuration name="demo-traffic">
    &traffic-generator;

    <!--
        Demo heartbeat: keeps the demo instance alive without anyone driving it.
        Each job sends a variant name to the generator adapter, which builds the
        matching HL7v2 message and posts it to the demo intakes. Most traffic is
        valid; a deliberate fraction exercises the reject/error paths so the
        error stores, journeys and dashboards always have something honest to show.

        Disable all generated traffic with -Ddemo.traffic.active=false.
        Quartz cron: second minute hour day-of-month month day-of-week.
        The jobs fire on distinct seconds so batches never collide.
    -->
    <Scheduler>
        <SendMessageJob name="DemoTraffic-AdtCardio" active="${demo.traffic.active:-true}"
                        description="Valid cardiology ADT admission/transfer/discharge — the happy path, every 2 minutes"
                        javaListener="DemoTrafficListener"
                        message="adt-cardio"
                        cronExpression="0 0/2 * ? * *"/>

        <SendMessageJob name="DemoTraffic-XmlTransform" active="${demo.traffic.active:-true}"
                        description="Valid ADT through the HL7v2-to-XML transform pipeline, every 5 minutes"
                        javaListener="DemoTrafficListener"
                        message="hl7-to-xml"
                        cronExpression="15 1/5 * ? * *"/>

        <SendMessageJob name="DemoTraffic-OtherDepartment" active="${demo.traffic.active:-true}"
                        description="Seeded reject: oncology admission that the CARDIO-only department filter refuses (AR NACK), every 10 minutes"
                        javaListener="DemoTrafficListener"
                        message="adt-other-department"
                        cronExpression="30 3/10 * ? * *"/>

        <SendMessageJob name="DemoTraffic-UnsupportedEvent" active="${demo.traffic.active:-true}"
                        description="Seeded reject: ORU^R01 lab result that the ADT intake does not support (AE NACK), every 15 minutes"
                        javaListener="DemoTrafficListener"
                        message="unsupported-event"
                        cronExpression="45 7/15 * ? * *"/>

        <SendMessageJob name="DemoTraffic-Malformed" active="${demo.traffic.active:-true}"
                        description="Seeded failure: structurally broken HL7v2 that fails parsing (intake ERROR exit), every 30 minutes"
                        javaListener="DemoTrafficListener"
                        message="malformed"
                        cronExpression="50 11/30 * ? * *"/>

        <SendMessageJob name="DemoTraffic-FhirDelivery" active="${demo.traffic.active:-true}"
                        description="Valid FHIR bundle into the async delivery queue, every 10 minutes (parks in the error store when ViscoStore is unreachable)"
                        javaListener="DemoTrafficListener"
                        message="fhir-bundle"
                        cronExpression="20 4/10 * ? * *"/>

        <SendMessageJob name="DemoTraffic-FhirDeliveryInvalid" active="${demo.traffic.active:-true}"
                        description="Seeded failure: bundle with an unknown resource type — rejected by ViscoStore, parks in the delivery error store, every 30 minutes"
                        javaListener="DemoTrafficListener"
                        message="fhir-bundle-invalid"
                        cronExpression="35 21/30 * ? * *"/>

        <SendMessageJob name="DemoTraffic-NlCorePatient" active="${demo.traffic.active:-true}"
                        description="Valid FHIR R4 nl-core Patient into the inbound zone via the nl-core intake, every 10 minutes"
                        javaListener="DemoTrafficListener"
                        message="nl-core-patient"
                        cronExpression="25 6/10 * ? * *"/>

        <SendMessageJob name="DemoTraffic-NlCorePatientInvalid" active="${demo.traffic.active:-true}"
                        description="Seeded reject: R4 patient with gender='onbekend' — refused by validation with an OperationOutcome (HTTP 422), every 30 minutes"
                        javaListener="DemoTrafficListener"
                        message="nl-core-patient-invalid"
                        cronExpression="40 26/30 * ? * *"/>
    </Scheduler>
</Configuration>
