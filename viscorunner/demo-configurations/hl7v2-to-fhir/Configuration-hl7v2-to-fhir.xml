<Module xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../FrankConfig.xsd">
    <Adapter name="HL7v2ToFHIR"
             description="Receives HL7v2 XML via JavaListener, transforms it to a FHIR ${fhir.target.version} transaction Bundle, validates it against the FHIR ${fhir.target.version} XSD, and POSTs it to viscostore">

        <Receiver name="HL7v2ToFHIRReceiver">
            <JavaListener name="HL7v2ToFHIRListener" />
        </Receiver>

        <Pipeline>
            <Exits>
                <Exit name="Exit" state="SUCCESS" />
                <Exit name="Exception" state="ERROR" />
                <Exit name="BadRequest" state="ERROR" code="400" />
                <Exit name="NotAuthorized" state="ERROR" code="401" />
                <Exit name="Forbidden" state="ERROR" code="403" />
                <Exit name="NotFound" state="ERROR" code="404" />
                <Exit name="NotAcceptable" state="ERROR" code="406" />
                <Exit name="UnsupportedMediaType" state="ERROR" code="415" />
                <Exit name="TooManyRequest" state="ERROR" code="429" />
                <Exit name="ServerError" state="ERROR" code="500" />
                <Exit name="ServiceUnavailable" state="ERROR" code="503" />
            </Exits>

            <PutInSessionPipe name="putGlobalsInSession">
                <!-- Use //h: wildcards so XPaths work regardless of the root element name
                     (ADT_A01, ADT_A02, ADT_A03, ADT_A09, …).
                     Route by MSG.2 (trigger event, e.g. A01/A08) rather than MSG.3
                     (message structure), because A04/A08/A13 all share the ADT_A01
                     structure name but need distinct XSLT files. -->
                <Param type="STRING" name="patientId"       xpathExpression="(//h:PID/h:PID.3/h:CX.1)[1]"   namespaceDefs="h=urn:hl7-org:v2xml" />
                <Param type="STRING" name="flow"            xpathExpression="concat('HL7v2 ', //h:MSH/h:MSH.9/h:MSG.1, '^', //h:MSH/h:MSH.9/h:MSG.2, ' → hl7v2-to-fhir')" namespaceDefs="h=urn:hl7-org:v2xml" />
                <Param type="STRING" name="hl7TriggerEvent" xpathExpression="//h:MSH/h:MSH.9/h:MSG.2"      namespaceDefs="h=urn:hl7-org:v2xml" />
                <Param type="STRING" name="mappingStyleSheet" xpathExpression="concat('./xslt/${fhir.target.version}/ADT_', //h:MSH/h:MSH.9/h:MSG.2, '.xslt')" namespaceDefs="h=urn:hl7-org:v2xml" />
            </PutInSessionPipe>

            <XsltPipe name="TransformHL7ToFHIR" styleSheetNameSessionKey="mappingStyleSheet">
                <Param name="mrSystemBase" value="${mr.system.base}"/>
            </XsltPipe>

            <!-- Validate the produced FHIR Bundle against the version-specific XSD.
                 fhir-single.xsd is resolved from the shared resources directory
                 (/opt/frank/resources/fhir-xsd/) via the Tomcat shared.loader classpath.
                 Run viscorunner/scripts/update-fhir-xsd.sh to regenerate the XSD files. -->
            <XmlValidatorPipe name="ValidateFhirBundle"
                              schema="fhir-xsd/${fhir.target.version}/fhir-single.xsd"
                              root="Bundle">
                <Forward name="success"   path="postToViscostore"/>
                <Forward name="failure"   path="BadRequest"/>
                <Forward name="exception" path="ServerError"/>
            </XmlValidatorPipe>

            <SenderPipe name="postToViscostore">
                <HttpSender
                    url="${viscostore.fhir.base.url}"
                    methodType="POST"
                    postType="RAW"
                    contentType="application/fhir+xml;charset=UTF-8"
                />
                <Forward name="success"   path="Exit"/>
                <Forward name="exception" path="Exception"/>
            </SenderPipe>
        </Pipeline>
    </Adapter>
</Module>