RewriteCond %{REQUEST_METHOD} ^GET$
RewriteCond %{HTTP:Accept} text/html
RewriteRule ^/viscolink/(.*)$ /runtime/$1 [R=302,L]
RewriteCond %{REQUEST_METHOD} ^GET$
RewriteCond %{HTTP:Accept} text/html
RewriteRule ^/viscolink$ /runtime/ [R=302,L]
RewriteRule ^/viscolink$ /runtime/ [L]
RewriteRule ^/viscolink/(.*)$ /runtime/$1 [L]
RewriteCond %{REQUEST_METHOD} ^GET$
RewriteCond %{HTTP:Accept} text/html
RewriteRule ^/viscostore/(.*)$ /fhir-store/$1 [R=302,L]
RewriteCond %{REQUEST_METHOD} ^GET$
RewriteCond %{HTTP:Accept} text/html
RewriteRule ^/viscostore$ /fhir-store/ [R=302,L]
RewriteRule ^/viscostore$ /fhir-store/ [L]
RewriteRule ^/viscostore/(.*)$ /fhir-store/$1 [L]
