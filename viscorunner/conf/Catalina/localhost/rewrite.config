RewriteCond %{SERVER_PORT} !^8080$
RewriteRule ^/(?:(?:runtime|viscolink)/)?api(/.*)?$ /runtime/tunnel-api$1 [L]
RewriteMap apigroups com.viscosiety.viscorunner.apigroups.ApiGroupsRewriteMap
RewriteCond %{SERVER_PORT} !^8080$
RewriteRule ^/.*$ /tunnel-not-found [L]
RewriteCond %{SERVER_PORT} ^8080$
RewriteRule ^/(?:runtime|viscolink)/tunnel-api(/.*)?$ /tunnel-not-found [L]
RewriteCond %{SERVER_PORT} ^8080$
RewriteCond ${apigroups:$1} ^yes$
RewriteRule ^/(?:runtime|viscolink)/api/([a-z][a-z0-9-]{1,29})(/.*)?$ /runtime/api-group/$1$2 [L]
RewriteCond %{REQUEST_METHOD} ^GET$
RewriteCond %{HTTP:Accept} text/html
RewriteRule ^/viscolink/(.*)$ /runtime/$1 [R=302,L]
RewriteCond %{REQUEST_METHOD} ^GET$
RewriteCond %{HTTP:Accept} text/html
RewriteRule ^/viscolink$ /runtime/ [R=302,L]
RewriteRule ^/viscolink$ /runtime/ [L]
RewriteRule ^/viscolink/(.*)$ /runtime/$1 [L]
RewriteCond %{REQUEST_METHOD} ^GET$
RewriteCond %{HTTP:Accept} text/html
RewriteRule ^/viscostore/(.*)$ /fhir-store/$1 [R=302,L]
RewriteCond %{REQUEST_METHOD} ^GET$
RewriteCond %{HTTP:Accept} text/html
RewriteRule ^/viscostore$ /fhir-store/ [R=302,L]
RewriteRule ^/viscostore$ /fhir-store/ [L]
RewriteRule ^/viscostore/(.*)$ /fhir-store/$1 [L]
RewriteCond %{REQUEST_METHOD} ^GET$
RewriteCond %{HTTP:Accept} text/html
RewriteRule ^/viscoforge/(.*)$ /console/$1 [R=302,L]
RewriteCond %{REQUEST_METHOD} ^GET$
RewriteCond %{HTTP:Accept} text/html
RewriteRule ^/viscoforge$ /console/ [R=302,L]
RewriteRule ^/viscoforge$ /console/ [L]
RewriteRule ^/viscoforge/(.*)$ /console/$1 [L]
