<?xml version="1.0" encoding="UTF-8"?>
<!--
  Session cookie (2026-11-08): the /runtime session cookie covers the whole site (Path=/) under its own
  name. The old /viscolink paths are served in place by the Host's RewriteValve (rewrite.config), but a
  browser only sends a cookie to paths under the cookie's Path: with Path=/runtime, a signed-in hosted
  page that called /viscolink/api/... (written before the move, 2026-10-28) arrived without its session
  and got 401. RUNTIMESESSIONID, not JSESSIONID: the other webapps (/console, /fhir-store) keep their own
  JSESSIONID under their own path, and a site-wide cookie with that name would travel next to theirs.
  Proven by RuntimeSessionCookieScopeTest.
-->
<Context sessionCookiePath="/" sessionCookieName="RUNTIMESESSIONID">
  <!--
    Extra web resources injected without pre-creating webapps/viscolink/.
    Files placed in /opt/frank/webapp-overlay/viscolink/ are served as
    if they were part of the viscolink webapp (same URL space).

    The demo overlay mounts loinc-mapping.html here instead of directly
    into webapps/viscolink/, which would cause Docker to pre-create that
    directory and cause Tomcat to skip WAR extraction (6 ms silent deploy).
  -->
  <Resources>
    <PreResources className="org.apache.catalina.webresources.DirResourceSet"
                   base="/opt/frank/webapp-overlay/viscolink"
                   webAppMount="/"
                   internalPath="/" />
  </Resources>
</Context>
