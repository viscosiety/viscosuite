<?xml version="1.0" encoding="UTF-8"?>
<Context>

		<Resource name="jdbc/viscolink"
			auth="Container"
			type="javax.sql.DataSource"
			driverClassName="${VISCOLINK_JDBC_DRIVER}"
			url="${VISCOLINK_JDBC_URL}"
			username="${VISCOLINK_JDBC_USERNAME}"
			password="${VISCOLINK_JDBC_PASSWORD}"
			maxTotal="20" maxIdle="5" maxWaitMillis="10000"/>

		<Resource name="jdbc/viscostore"
			auth="Container"
			type="javax.sql.DataSource"
			driverClassName="${VISCOSTORE_JDBC_DRIVER}"
			url="${VISCOSTORE_JDBC_URL}"
			username="${VISCOSTORE_JDBC_USERNAME}"
			password="${VISCOSTORE_JDBC_PASSWORD}"
			maxTotal="20" maxIdle="5" maxWaitMillis="10000"/>


		<!-- Ladybug reports on their OWN datasource: a report written on the business
		     datasource joins the receiver's transaction, so the report of a FAILED
		     transacted message is rolled back with it and the journey is lost.
		     Works with any database the drivers directory supports; for an
		     H2-based deployment set:
		       LADYBUG_JDBC_DRIVER=org.h2.Driver
		       LADYBUG_JDBC_URL=jdbc:h2:file:/opt/frank/h2/ladybug
		     (a SEPARATE file from the business database — sharing the file would
		     reintroduce the rollback problem via the same database). -->
		<Resource name="jdbc/ladybug"
			auth="Container"
			type="javax.sql.DataSource"
			driverClassName="${LADYBUG_JDBC_DRIVER}"
			url="${LADYBUG_JDBC_URL}"
			username="${LADYBUG_JDBC_USERNAME}"
			password="${LADYBUG_JDBC_PASSWORD}"
			maxTotal="10" maxIdle="2" maxWaitMillis="10000"/>

</Context>
