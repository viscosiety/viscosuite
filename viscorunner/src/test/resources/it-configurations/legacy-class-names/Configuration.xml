<!DOCTYPE Configuration>
<!--
  LegacyClassNamesIT: the health pack's classes moved to com.viscosiety.pack.health.*; the old names of the
  seven classes a configuration uses stay loadable. This configuration names a pipe and a listener by their
  OLD names and the same pipe by its NEW name, so the IT can prove both load side by side.
-->
<Configuration name="legacy-class-names">
	<Adapter name="OldPipeName">
		<Receiver name="OldPipeNameReceiver">
			<ApiListener name="OldPipeNameListener" uriPattern="legacy/old" method="POST" produces="XML"/>
		</Receiver>
		<Pipeline>
			<Exits>
				<Exit name="Exit" state="SUCCESS" code="200"/>
			</Exits>
			<Pipe className="com.viscosiety.pipes.Hl7v2ToXmlPipe" name="parse" hl7Version="2.5" validateMessage="false"/>
		</Pipeline>
	</Adapter>

	<Adapter name="NewPipeName">
		<Receiver name="NewPipeNameReceiver">
			<ApiListener name="NewPipeNameListener" uriPattern="legacy/new" method="POST" produces="XML"/>
		</Receiver>
		<Pipeline>
			<Exits>
				<Exit name="Exit" state="SUCCESS" code="200"/>
			</Exits>
			<Pipe className="com.viscosiety.pack.health.pipes.Hl7v2ToXmlPipe" name="parse" hl7Version="2.5" validateMessage="false"/>
		</Pipeline>
	</Adapter>

	<Adapter name="OldListenerName">
		<Receiver name="OldListenerNameReceiver">
			<Listener className="com.viscosiety.fhir.FhirListener"
					  name="OldListenerNamePatientRead"
					  fhirVersion="R4"
					  facadeName="legacy-names"
					  resourceType="Patient"
					  operation="read"/>
		</Receiver>
		<Pipeline>
			<Exits>
				<Exit name="Exit" state="SUCCESS" code="200"/>
			</Exits>
			<EchoPipe name="echo"/>
		</Pipeline>
	</Adapter>
</Configuration>
