# Copy this file to credentials.properties (gitignored) and fill in local values.
# In production, mount this from a Kubernetes Secret or Docker secret.
#
# Format: alias/property=value
# Example for a datasource alias used in Frank configurations:
#   viscolink.datasource/username=sa
#   viscolink.datasource/password=secret

# Fake EMR — external PostgreSQL over TLS
# The password can also be set directly in docker-compose.yml for local dev;
# use this file when you want it out of the compose file.
# fake.emr.jdbc.password=<password>
