<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.visco</groupId>
		<artifactId>viscosuite-parent</artifactId>
		<version>1.2.1-SNAPSHOT</version>
	</parent>

	<artifactId>viscorunner</artifactId>
	<packaging>jar</packaging>

	<name>ViscoRunner</name>

	<properties>
		<maven.compiler.release>21</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	</properties>

	<dependencies>
		<!-- Both WARs are collected and placed in target/ by maven-dependency-plugin -->
		<dependency>
			<groupId>com.visco</groupId>
			<artifactId>viscolink</artifactId>
			<version>${project.version}</version>
			<type>war</type>
		</dependency>
		<dependency>
			<groupId>com.visco</groupId>
			<artifactId>viscostore</artifactId>
			<version>${project.version}</version>
			<type>war</type>
		</dependency>
		<!-- The health pack's overlay zip (WEB-INF/lib + WEB-INF/classes),
		     unpacked to target/packs/health/ by unpack-health-overlay. -->
		<dependency>
			<groupId>com.visco</groupId>
			<artifactId>viscolink-pack-health</artifactId>
			<version>${project.version}</version>
			<type>zip</type>
			<classifier>overlay</classifier>
			<!-- The overlay is a bag of files to unpack, not a library: without this the pack's runtime
			     transitives (HAPI, ~190 MB) would be shaded into the viscorunner jar on /opt/frank/lib. -->
			<exclusions>
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<!-- JDBC drivers placed in /opt/frank/drivers — loaded by Tomcat's common.loader, shared between both WARs -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<version>${postgresql.version}</version>
		</dependency>
		<!-- H2 must also be at Tomcat level because context.xml JNDI resources are initialised by Tomcat, not the WAR -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<version>2.4.240</version>
		</dependency>

		<!-- Kubernetes client for ContextFailureEventPublisher. Compile scope so it (and its runtime
		     transitives) is shaded into the viscorunner jar on Tomcat's common.loader at
		     /opt/frank/lib. The shade below RELOCATES io.fabric8, so the webapps never see this copy
		     (its classes or its META-INF/services registrations) and it may differ from the copies
		     inside the WARs. JDK HTTP client instead of Vert.x: no Vert.x or Netty on the shared
		     class loader. SharedJarIsolationIT checks both on the packaged jar. -->
		<dependency>
			<groupId>io.fabric8</groupId>
			<artifactId>kubernetes-client</artifactId>
			<version>8.0.0</version>
			<exclusions>
				<exclusion>
					<groupId>io.fabric8</groupId>
					<artifactId>kubernetes-httpclient-vertx-5</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>io.fabric8</groupId>
			<artifactId>kubernetes-httpclient-jdk</artifactId>
			<version>8.0.0</version>
		</dependency>
		<!-- Catalina API for the Server LifecycleListener. Provided: Tomcat supplies it at runtime,
		     so it is NOT assembled into /opt/frank/lib. -->
		<dependency>
			<groupId>org.apache.tomcat</groupId>
			<artifactId>tomcat-catalina</artifactId>
			<version>11.0.18</version>
			<scope>provided</scope>
		</dependency>

		<!-- ── Integration-test dependencies ─────────────────────────────────────────────── -->

		<!-- JUnit 5 -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<version>5.11.4</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
			<version>5.11.4</version>
			<scope>test</scope>
		</dependency>

		<!-- Polling helper -->
		<dependency>
			<groupId>org.awaitility</groupId>
			<artifactId>awaitility</artifactId>
			<version>4.2.0</version>
			<scope>test</scope>
		</dependency>

		<!-- Mockito — mock Catalina Server/Engine/Host/Context for ContextFailureEventPublisher tests -->
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-junit-jupiter</artifactId>
			<version>5.14.2</version>
			<scope>test</scope>
		</dependency>

		<!-- HAPI FHIR REST client + R4 model (used by LabEnrichmentIT to seed/read resources) -->
		<dependency>
			<groupId>ca.uhn.hapi.fhir</groupId>
			<artifactId>hapi-fhir-client</artifactId>
			<version>${hapi.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>ca.uhn.hapi.fhir</groupId>
			<artifactId>hapi-fhir-structures-r4</artifactId>
			<version>${hapi.version}</version>
			<scope>test</scope>
		</dependency>

		<!-- HAPI HL7v2 — used by Hl7v2ToFhirIT to convert pipe-delimited messages to
		     HL7v2 XML before POSTing to the viscolink HTTP endpoint (test JVM only) -->
		<dependency>
			<groupId>ca.uhn.hapi</groupId>
			<artifactId>hapi-base</artifactId>
			<version>2.5.1</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>ca.uhn.hapi</groupId>
			<artifactId>hapi-structures-v25</artifactId>
			<version>2.5.1</version>
			<scope>test</scope>
		</dependency>

		<!-- ── Launcher JVM classpath JARs ───────────────────────────────────────────────
		     These are declared here so Maven resolves and caches them in .m2/.
		     maven-dependency-plugin copies them to target/launcher-libs/ at
		     pre-integration-test so LabEnrichmentIT can reference them by path
		     without depending on the .m2/ location. None are loaded by the test JVM:
		     tomcat-embed-core is the only one needed for compile (ViscolinkLauncher). -->
		<dependency>
			<groupId>org.apache.tomcat.embed</groupId>
			<artifactId>tomcat-embed-core</artifactId>
			<version>11.0.18</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.tomcat.embed</groupId>
			<artifactId>tomcat-embed-websocket</artifactId>
			<version>11.0.18</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.tomcat.embed</groupId>
			<artifactId>tomcat-embed-el</artifactId>
			<version>11.0.18</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.tomcat.embed</groupId>
			<artifactId>tomcat-embed-jasper</artifactId>
			<version>11.0.18</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.tomcat</groupId>
			<artifactId>tomcat-dbcp</artifactId>
			<version>11.0.18</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>jakarta.annotation</groupId>
			<artifactId>jakarta.annotation-api</artifactId>
			<version>3.0.0</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<version>2.18.3</version>
			<scope>test</scope>
			<!-- Test scope only, and WITHOUT its jackson-annotations: a direct 2.18.3 annotations jar would win
			     Maven's nearest-wins mediation over the 2.22 that fabric8's Jackson 3 needs on the shaded jar
			     (SharedJarIsolationIT caught it: NoClassDefFoundError JsonSerializeAs). Annotations 2.22 is
			     backward compatible for readTree. -->
			<exclusions>
				<exclusion>
					<groupId>com.fasterxml.jackson.core</groupId>
					<artifactId>jackson-annotations</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
	</dependencies>

	<build>
		<defaultGoal>package</defaultGoal>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.13.0</version>
				<configuration>
					<release>21</release>
				</configuration>
			</plugin>

			<!-- Run integration tests (*IT.java) during verify phase -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<version>3.5.2</version>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.8.0</version>
				<executions>
					<!-- Copy launcher JARs to target/launcher-libs/ so LabEnrichmentIT can build
					     the ViscolinkLauncher classpath without depending on the .m2/ location.
					     Runs at pre-integration-test so the JARs are ready before failsafe fires. -->
					<execution>
						<id>copy-launcher-libs</id>
						<phase>pre-integration-test</phase>
						<goals>
							<goal>copy</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}/launcher-libs</outputDirectory>
							<stripVersion>true</stripVersion>
							<artifactItems>
								<artifactItem>
									<groupId>org.apache.tomcat.embed</groupId>
									<artifactId>tomcat-embed-core</artifactId>
									<version>11.0.18</version>
								</artifactItem>
								<artifactItem>
									<groupId>org.apache.tomcat.embed</groupId>
									<artifactId>tomcat-embed-websocket</artifactId>
									<version>11.0.18</version>
								</artifactItem>
								<artifactItem>
									<groupId>org.apache.tomcat.embed</groupId>
									<artifactId>tomcat-embed-el</artifactId>
									<version>11.0.18</version>
								</artifactItem>
								<artifactItem>
									<groupId>org.apache.tomcat.embed</groupId>
									<artifactId>tomcat-embed-jasper</artifactId>
									<version>11.0.18</version>
								</artifactItem>
								<artifactItem>
									<groupId>org.apache.tomcat</groupId>
									<artifactId>tomcat-dbcp</artifactId>
									<version>11.0.18</version>
								</artifactItem>
								<artifactItem>
									<groupId>jakarta.annotation</groupId>
									<artifactId>jakarta.annotation-api</artifactId>
									<version>3.0.0</version>
								</artifactItem>
								<artifactItem>
									<groupId>com.h2database</groupId>
									<artifactId>h2</artifactId>
									<version>2.4.240</version>
								</artifactItem>
							</artifactItems>
						</configuration>
					</execution>
					<!-- Copy both WARs to target/ (stripped of version suffix for predictable Dockerfile COPY paths) -->
					<execution>
						<id>copy-wars</id>
						<phase>package</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}</outputDirectory>
							<includeTypes>war</includeTypes>
							<stripVersion>true</stripVersion>
							<overWriteSnapshots>true</overWriteSnapshots>
						</configuration>
					</execution>
					<!-- Copy JDBC drivers to target/drivers/ — will be placed in /opt/frank/drivers inside the image -->
					<execution>
						<id>copy-drivers</id>
						<phase>package</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}/drivers</outputDirectory>
							<includeArtifactIds>postgresql,h2</includeArtifactIds>
							<stripVersion>true</stripVersion>
							<overWriteSnapshots>true</overWriteSnapshots>
						</configuration>
					</execution>
					<!-- The health pack's overlay (WEB-INF/lib + classes) → target/packs/health/ -->
					<execution>
						<id>unpack-health-overlay</id>
						<phase>package</phase>
						<goals><goal>unpack</goal></goals>
						<configuration>
							<overWriteSnapshots>true</overWriteSnapshots>
							<overWriteReleases>true</overWriteReleases>
							<artifactItems>
								<artifactItem>
									<groupId>com.visco</groupId>
									<artifactId>viscolink-pack-health</artifactId>
									<version>${project.version}</version>
									<type>zip</type>
									<classifier>overlay</classifier>
									<outputDirectory>${project.build.directory}/packs/health</outputDirectory>
								</artifactItem>
							</artifactItems>
						</configuration>
					</execution>
					<!-- The health overlay zip as a component file for local fat builds (file:// list). -->
					<execution>
						<id>copy-health-overlay-component</id>
						<phase>package</phase>
						<goals><goal>copy</goal></goals>
						<configuration>
							<overWriteSnapshots>true</overWriteSnapshots>
							<overWriteReleases>true</overWriteReleases>
							<stripVersion>true</stripVersion>
							<artifactItems>
								<artifactItem>
									<groupId>com.visco</groupId>
									<artifactId>viscolink-pack-health</artifactId>
									<version>${project.version}</version>
									<type>zip</type>
									<classifier>overlay</classifier>
									<outputDirectory>${project.build.directory}/components</outputDirectory>
								</artifactItem>
							</artifactItems>
						</configuration>
					</execution>
					<!-- Lemma's JNI library for the two Linux architectures the images are built for →
					     target/native/<rust-triple>/liblemma_jni.so. The Dockerfile copies the one for
					     its own architecture to /opt/frank/native/. Version = viscolink/pom.xml's
					     lemma-engine; change both together. -->
					<execution>
						<id>unpack-lemma-natives</id>
						<phase>package</phase>
						<goals><goal>unpack</goal></goals>
						<configuration>
							<overWriteReleases>true</overWriteReleases>
							<artifactItems>
								<artifactItem>
									<groupId>com.lemmabase</groupId>
									<artifactId>lemma-engine</artifactId>
									<version>0.10.0</version>
									<type>jar</type>
									<includes>native/x86_64-unknown-linux-gnu/liblemma_jni.so,native/aarch64-unknown-linux-gnu/liblemma_jni.so</includes>
									<outputDirectory>${project.build.directory}</outputDirectory>
								</artifactItem>
							</artifactItems>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Everything the one Dockerfile COPYs besides the WARs, the drivers and the unpacked health
			     overlay: the demo configurations per pack and the components (store WAR, health overlay zip)
			     a local fat build fetches, with their lists.
			     Declared AFTER maven-dependency-plugin: same-phase executions run in declaration order and
			     the store copy needs target/viscostore.war from copy-wars. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>3.1.0</version>
				<executions>
					<!-- dependency:unpack and the copies below only add files: start from nothing so a jar a new
					     provided declaration dropped never survives an incremental build. -->
					<execution>
						<id>reset-staging</id>
						<phase>prepare-package</phase>
						<goals><goal>run</goal></goals>
						<configuration>
							<target>
								<delete dir="${project.build.directory}/packs"/>
								<delete dir="${project.build.directory}/demo"/>
								<delete dir="${project.build.directory}/store"/>
								<delete dir="${project.build.directory}/components"/>
								<delete file="${project.build.directory}/components-suite.list"/>
								<delete file="${project.build.directory}/components-viscolink.list"/>
							</target>
						</configuration>
					</execution>
					<!-- The demo sets (both baked into viscobase) and the components a local fat build fetches:
					     target/components/ holds the store WAR and the health overlay zip, and the two lists name
					     them with file:// URLs under /opt/frank/component-files/ (where the Dockerfile's fat stage
					     copies target/components/) and their sha256. CI writes the same lists with registry URLs
					     (scripts/ci/publish.sh); the fetcher does not care which. -->
					<execution>
						<id>stage-demos-and-components</id>
						<phase>package</phase>
						<goals><goal>run</goal></goals>
						<configuration>
							<target>
								<copy todir="${project.build.directory}/demo/health" overwrite="true">
									<fileset dir="${project.basedir}/../packs/health/demo-configurations"/>
								</copy>
								<copy todir="${project.build.directory}/demo/core" overwrite="true">
									<fileset dir="${project.basedir}/../viscolink/demo-configurations"/>
								</copy>
								<mkdir dir="${project.build.directory}/components"/>
								<copy file="${project.build.directory}/viscostore.war"
								      tofile="${project.build.directory}/components/viscostore.war" overwrite="true"/>
								<checksum file="${project.build.directory}/components/viscostore.war" algorithm="SHA-256" property="sha.viscostore"/>
								<checksum file="${project.build.directory}/components/viscolink-pack-health-overlay.zip" algorithm="SHA-256" property="sha.pack"/>
								<echo file="${project.build.directory}/components-suite.list" append="false" message="release ${project.version}${line.separator}store war ${project.version} file:///opt/frank/component-files/viscostore.war ${sha.viscostore} fhir-store${line.separator}pack-health overlay ${project.version} file:///opt/frank/component-files/viscolink-pack-health-overlay.zip ${sha.pack} overlay/runtime${line.separator}"/>
								<echo file="${project.build.directory}/components-viscolink.list" append="false" message="release ${project.version}${line.separator}pack-health overlay ${project.version} file:///opt/frank/component-files/viscolink-pack-health-overlay.zip ${sha.pack} overlay/runtime${line.separator}"/>
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Shade the Kubernetes client (fabric8) + its runtime transitives into the viscorunner
			     jar, with Jackson/SnakeYAML RELOCATED. The jar is placed on Tomcat's common.loader
			     (/opt/frank/lib) for ContextFailureEventPublisher; relocating Jackson keeps plain
			     com.fasterxml.jackson.* OFF the shared classloader, so a WAR that resolves a Jackson
			     class across the WEB-INF/lib boundary can never pick up a conflicting shared copy
			     (which caused a YAMLFactory/JsonFactory VerifyError in viscoforge.war). -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.6.0</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<createDependencyReducedPom>false</createDependencyReducedPom>
							<shadedArtifactAttached>false</shadedArtifactAttached>
							<artifactSet>
								<excludes>
									<!-- WARs, the pack overlay and JDBC drivers are placed elsewhere; Catalina is provided. -->
									<exclude>com.visco:viscolink</exclude>
									<exclude>com.visco:viscostore</exclude>
									<exclude>com.visco:viscolink-pack-health</exclude>
									<exclude>org.postgresql:postgresql</exclude>
									<exclude>com.h2database:h2</exclude>
									<exclude>org.apache.tomcat:*</exclude>
								</excludes>
							</artifactSet>
							<relocations>
								<relocation>
									<pattern>org.slf4j</pattern>
									<shadedPattern>com.viscosiety.shaded.org.slf4j</shadedPattern>
								</relocation>
								<relocation>
									<pattern>org.checkerframework</pattern>
									<shadedPattern>com.viscosiety.shaded.org.checkerframework</shadedPattern>
								</relocation>
								<relocation>
									<pattern>tools.jackson</pattern>
									<shadedPattern>com.viscosiety.shaded.tools.jackson</shadedPattern>
								</relocation>
								<relocation>
									<pattern>io.fabric8</pattern>
									<shadedPattern>com.viscosiety.shaded.io.fabric8</shadedPattern>
								</relocation>
								<relocation>
									<pattern>com.fasterxml.jackson</pattern>
									<shadedPattern>com.viscosiety.shaded.com.fasterxml.jackson</shadedPattern>
								</relocation>
								<relocation>
									<pattern>org.yaml.snakeyaml</pattern>
									<shadedPattern>com.viscosiety.shaded.org.yaml.snakeyaml</shadedPattern>
								</relocation>
								<relocation>
									<pattern>org.snakeyaml.engine</pattern>
									<shadedPattern>com.viscosiety.shaded.org.snakeyaml.engine</shadedPattern>
								</relocation>
							</relocations>
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
							</transformers>
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
										<exclude>module-info.class</exclude>
										<!-- Multi-release variants are not relocated by the shade; the base
										     classes (relocated) are used instead. -->
										<exclude>META-INF/versions/**</exclude>
									</excludes>
								</filter>
							</filters>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
