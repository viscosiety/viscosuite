# Same base image as the combined runner — ViscoStore WAR runs in Tomcat
FROM tomcat:11.0.14-jre25

ARG GID=2000
ARG UID=2000

# curl for the HEALTHCHECK: the Java 25 base image does not ship it (the Java 21 one did).
# Installed BEFORE the hardening below (apt cannot run after it).
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && rm -rf /var/lib/apt/lists/*

# Harden file permissions (CIS-DI-0008)
RUN chmod -R 751 /usr/bin /usr/sbin

# Only the drivers directory is needed — no Frank!Framework runtime dirs
RUN set -eux && \
	mkdir -p /opt/frank/drivers && \
	groupadd -g ${GID} tomcat && \
	useradd -u ${UID} -g tomcat -s /usr/sbin/nologin -l tomcat -d ${CATALINA_HOME} && \
	chown -hR tomcat:tomcat ${CATALINA_HOME} && \
	chown -hR tomcat:tomcat /opt/frank

USER tomcat

# Minimal Tomcat settings: only common.loader and JAR scan suppression
COPY --chown=tomcat src/scripts/catalinaAdditional-viscostore.properties /tmp/catalinaAdditional.properties
RUN cat /tmp/catalinaAdditional.properties >> /usr/local/tomcat/conf/catalina.properties && \
	rm /tmp/catalinaAdditional.properties

# JDBC drivers on common.loader so Spring can find the driver class
COPY --chown=tomcat target/drivers/ /opt/frank/drivers/

# The landing page is shared with the runner image; there it reads the pack from components.json, which
# this image never has, so it shows the core's words. Only the build stamp is baked.
COPY --chown=tomcat src/webapp/ROOT/ /usr/local/tomcat/webapps/ROOT/
ARG BUILD_TIMESTAMP=""
RUN BUILD_TS="${BUILD_TIMESTAMP:-$(date -u '+%Y-%m-%d %H:%M UTC')}"; \
    sed -i "s|%%BUILD_TIMESTAMP%%| \&middot; Built ${BUILD_TS}|" /usr/local/tomcat/webapps/ROOT/index.html
# Served at /fhir-store (neutral web path, 2026-10-28); the old /viscostore keeps working through the
# Host's RewriteValve, added to this image's stock server.xml (see the runner Dockerfile for the rules).
COPY --chown=tomcat target/viscostore.war /usr/local/tomcat/webapps/fhir-store.war
COPY --chown=tomcat conf/Catalina/localhost/rewrite.config /usr/local/tomcat/conf/Catalina/localhost/rewrite.config
RUN set -e; f=/usr/local/tomcat/conf/server.xml; \
    sed -i 's#<Valve className="org.apache.catalina.valves.AccessLogValve"#<Valve className="org.apache.catalina.valves.rewrite.RewriteValve" />\n        <Valve className="org.apache.catalina.valves.AccessLogValve"#' "$f"; \
    grep -q '^        <Valve className="org.apache.catalina.valves.rewrite.RewriteValve" />$' "$f" || { echo "ERROR: no RewriteValve in $f; re-check after a base-image bump"; exit 1; }

# Fail fast if the WAR is a stale empty stub from .m2/ (< 1 MB)
RUN set -e; \
    vs=$(stat -c%s /usr/local/tomcat/webapps/fhir-store.war); \
    [ "$vs" -gt 1000000 ] || { echo ""; echo "ERROR: fhir-store.war (viscostore.war) is ${vs} bytes — stale stub. Run:"; \
        echo "  ./mvnw install -pl viscostore && ./mvnw package -pl viscorunner"; echo ""; exit 1; }

COPY --chown=tomcat src/scripts/entrypoint.sh /scripts/entrypoint.sh

# ViscoStore exposes its FHIR CapabilityStatement at /fhir/metadata — use it as the health probe
HEALTHCHECK --interval=15s --timeout=5s --start-period=90s --retries=3 \
	CMD curl --fail --silent http://localhost:8080/fhir-store/fhir/metadata || exit 1

ENTRYPOINT ["/scripts/entrypoint.sh"]
CMD ["catalina.sh", "run"]
