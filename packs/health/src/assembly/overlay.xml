<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 http://maven.apache.org/xsd/assembly-2.2.0.xsd">
	<!-- The tree of this zip IS the webapp overlay (/opt/frank/webapp-overlay/viscolink/). -->
	<id>overlay</id>
	<formats><format>zip</format></formats>
	<includeBaseDirectory>false</includeBaseDirectory>
	<files>
		<!-- The pack's own jar. -->
		<file>
			<source>${project.build.directory}/${project.build.finalName}.jar</source>
			<outputDirectory>WEB-INF/lib</outputDirectory>
		</file>
	</files>
	<fileSets>
		<fileSet>
			<!-- The runtime closure minus everything marked provided: exactly the jars the core WAR lacks.
			     Staged by maven-dependency-plugin:copy-dependencies (stage-overlay-libs), not by an assembly
			     dependencySet (which would re-resolve and ignore the provided declarations). -->
			<directory>${project.build.directory}/overlay-libs</directory>
			<outputDirectory>WEB-INF/lib</outputDirectory>
		</fileSet>
		<fileSet>
			<directory>${project.build.directory}/console-patched</directory>
			<outputDirectory>WEB-INF/classes</outputDirectory>
			<!-- console/index.html, staged by the pom's patch-console-index execution at process-resources. -->
		</fileSet>
		<fileSet>
			<directory>src/main/overlay</directory>
			<outputDirectory>/</outputDirectory>
			<filtered>true</filtered>
		</fileSet>
	</fileSets>
</assembly>
