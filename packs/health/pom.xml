	<build>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>false</filtering>
			</resource>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>true</filtering>
				<includes><include>pack-version.properties</include></includes>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.14.0</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<archive>
						<manifest>
							<!-- Implementation-Title/-Version: F!F's ModuleInformation reads them (HealthPackModule). -->
							<addDefaultImplementationEntries>true</addDefaultImplementationEntries>
						</manifest>
					</archive>
				</configuration>
			</plugin>
			<!-- Redirect F!F's log directory during tests (same reason as viscolink/pom.xml). -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<systemPropertyVariables>
						<log.dir>${project.build.directory}/logs</log.dir>
					</systemPropertyVariables>
				</configuration>
			</plugin>
			<!-- The FHIR block of the Frank!Console. The console's index.html is one file that never merges
			     across jars, so the pack's build extracts the framework's page, adds the script tag and
			     stages it as target/console-patched/console/index.html; the overlay assembly lays it into
			     WEB-INF/classes, where it shadows the page inside frankframework-console-frontend.jar.
			     The script itself (console/fhir-webservices.js) is a resource of this jar. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>unpack-console-index</id>
						<phase>generate-resources</phase>
						<goals><goal>unpack</goal></goals>
						<configuration>
							<!-- overWriteSnapshots forces re-extraction from the current SNAPSHOT JAR on every
							     build so the patched index.html always matches the bundled JS asset hash. -->
							<overWriteSnapshots>true</overWriteSnapshots>
							<artifactItems>
								<artifactItem>
									<groupId>org.frankframework</groupId>
									<artifactId>frankframework-console-frontend</artifactId>
									<version>${frankframework.version}</version>
									<includes>console/index.html</includes>
									<outputDirectory>${project.build.directory}/console-original</outputDirectory>
								</artifactItem>
							</artifactItems>
						</configuration>
					</execution>
					<!-- The overlay's WEB-INF/lib: Maven's own runtime closure of this pom (compile + runtime,
					     provided excluded), staged for the assembly. The assembly plugin's dependencySet is
					     NOT used for the libraries: it re-resolves the direct non-provided dependencies on its
					     own, so a direct <scope>provided</scope> declaration never removed a transitive of
					     HAPI from the zip (measured: 115 jars before and after 25 declarations). This copy
					     uses the resolved graph, where a direct provided declaration does win, and where the
					     provided core (viscolink:classes) takes part in version mediation, so the libraries
					     the pack shares with the WAR resolve to the WAR's versions. -->
					<execution>
						<id>stage-overlay-libs</id>
						<phase>prepare-package</phase>
						<goals><goal>copy-dependencies</goal></goals>
						<configuration>
							<includeScope>runtime</includeScope>
							<outputDirectory>${project.build.directory}/overlay-libs</outputDirectory>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- Inject <script src="fhir-webservices.js"> into the extracted index.html. Phase
			     process-resources (not prepare-package): the staged page must exist when the tests run
			     and when the assembly packs it. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>3.1.0</version>
				<executions>
					<!-- copy-dependencies only adds files: without this, a jar that a new provided declaration
					     dropped would stay in an incremental build's overlay. -->
					<execution>
						<id>reset-overlay-libs</id>
						<phase>generate-resources</phase>
						<goals><goal>run</goal></goals>
						<configuration>
							<target>
								<delete dir="${project.build.directory}/overlay-libs"/>
							</target>
						</configuration>
					</execution>
					<execution>
						<id>patch-console-index</id>
						<phase>process-resources</phase>
						<goals><goal>run</goal></goals>
						<configuration>
							<target>
								<mkdir dir="${project.build.directory}/console-patched/console"/>
								<copy file="${project.build.directory}/console-original/console/index.html"
								      tofile="${project.build.directory}/console-patched/console/index.html"
								      overwrite="true"/>
								<replace file="${project.build.directory}/console-patched/console/index.html">
									<replacetoken><![CDATA[</body>]]></replacetoken>
									<replacevalue><![CDATA[<script src="fhir-webservices.js"></script></body>]]></replacevalue>
								</replace>
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- The overlay zip: WEB-INF/lib = this jar + target/overlay-libs (stage-overlay-libs);
			     WEB-INF/classes and WEB-INF/pack.properties come from the assembly descriptor. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
				<version>3.7.1</version>
				<executions>
					<execution>
						<id>overlay</id>
						<phase>package</phase>
						<goals><goal>single</goal></goals>
						<configuration>
							<descriptors><descriptor>src/assembly/overlay.xml</descriptor></descriptors>
							<appendAssemblyId>true</appendAssemblyId>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	<repositories>
		<repository>
			<id>frankframework</id>
			<name>Frank!Framework</name>
			<url>https://nexus.frankframework.org/content/repositories/public</url>
		</repository>
	</repositories>
</project>
