<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0"
         metadata-complete="false">

  <!-- Override Tomcat's default welcome file (index.html) which F!F intercepts via RedirectIndexProxy -->
  <welcome-file-list>
    <welcome-file>home.html</welcome-file>
  </welcome-file-list>

  <!-- Tool-page security is registered programmatically by ConsoleSecurityRegistrar
       (com.viscosiety.security), which reuses F!F's own console authentication chain so the tools
       authenticate exactly like the Frank!Console (Basic / OIDC / open). No security filter is
       declared here. -->

  <!-- Adds crossorigin="use-credentials" to the console index's manifest link: browsers fetch
       <link rel="manifest"> without cookies by default, so behind OAuth2 the manifest request
       302s to Keycloak and F!F's CSP (default-src 'self') blocks it with a console error on
       every page load. Spring Security's programmatic filter (isMatchAfter=false) still runs
       before declared filters, so authentication is unaffected. -->
  <filter>
    <filter-name>consoleManifestCredentials</filter-name>
    <filter-class>com.viscosiety.security.ConsoleManifestCredentialsFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>consoleManifestCredentials</filter-name>
    <url-pattern>/iaf/gui/*</url-pattern>
  </filter-mapping>

  <servlet>
    <servlet-name>ToolsServlet</servlet-name>
    <servlet-class>com.viscosiety.tools.ToolsServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>ToolsServlet</servlet-name>
    <url-pattern>/tools/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>FlowController</servlet-name>
    <servlet-class>com.viscosiety.flow.FlowController</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>FlowController</servlet-name>
    <url-pattern>/flow-api/*</url-pattern>
  </servlet-mapping>

</web-app>
