<?xml version="1.0" encoding="UTF-8"?>
<!--
    Registered via ViscoLinkModule.getSpringConfigurationFiles(), so it is part of the application
    context that creates every Configuration. ApiListenerParamsDefault makes allowAllParams default to
    false for every ApiListener (see its Javadoc).
-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
       ">

    <bean id="apiListenerParamsDefault" class="com.viscosiety.api.ApiListenerParamsDefault"/>
</beans>
