<?xml version="1.0" encoding="UTF-8"?>
<beans
    xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd"
    >

    <import resource="springIbisTestTool.xml" />

    <bean name="metadataExtractor" class="org.wearefrank.ladybug.MetadataExtractor">
        <property name="extraMetadataFieldExtractors">
            <list>
                <bean class="org.wearefrank.ladybug.metadata.StatusMetadataFieldExtractor" />
                <!-- Origin-independent provenance flag: "true" when the report is a replay/synthetic run
                     rather than a real production message, detected from the correlation-id prefix
                     (stubbed-run-* from ViscoFlow's StubbedRunner, or <LadybugName>-* from a native
                     Ladybug rerun). Independent of whether any sender was stubbed. See the class javadoc. -->
                <bean class="com.viscosiety.ladybug.StubMetadataFieldExtractor" />
                <bean class="org.wearefrank.ladybug.metadata.SessionKeyMetadataFieldExtractor">
                    <property name="name" value="flow"/>
                    <property name="label" value="Flow"/>
                    <property name="sessionKey" value="flow" />
                </bean>
                <bean class="org.wearefrank.ladybug.metadata.SessionKeyMetadataFieldExtractor">
                    <property name="name" value="patientId"/>
                    <property name="label" value="PatientId"/>
                    <property name="sessionKey" value="patientId" />
                </bean>
                <!-- De-identified stubbed runs are marked by StubbedRunner with two session keys:
                     sharable=true (the report is a PHI-free synthetic copy) and originId=<source report id>.
                     These are extracted as metadata so the Shareable view (below) can FILTER on sharable
                     and SHOW originId. They are intentionally absent from the default `metadataNames`
                     (the standard views' column set), so ordinary reports stay uncluttered. -->
                <bean class="org.wearefrank.ladybug.metadata.SessionKeyMetadataFieldExtractor">
                    <property name="name" value="sharable"/>
                    <property name="label" value="Sharable"/>
                    <property name="sessionKey" value="sharable" />
                </bean>
                <bean class="org.wearefrank.ladybug.metadata.SessionKeyMetadataFieldExtractor">
                    <property name="name" value="originId"/>
                    <property name="label" value="Origin Storage Id"/>
                    <property name="sessionKey" value="originId" />
                </bean>
            </list>
        </property>
    </bean>

    <!-- Default column set for the standard views (whitebox/graybox/blackbox) — WITHOUT sharable/originId. -->
    <bean name="metadataNames" class="java.util.ArrayList">
        <constructor-arg>
            <list>
                <value>storageId</value>
                <value>endTime</value>
                <value>duration</value>
                <value>name</value>
                <value>flow</value>
                <value>patientId</value>
                <value>correlationId</value>
                <value>status</value>
                <value>stubbed</value>
                <value>numberOfCheckpoints</value>
                <value>estimatedMemoryUsage</value>
                <value>storageSize</value>
            </list>
        </constructor-arg>
    </bean>

    <!-- Column set for the Shareable view: the defaults plus the originId provenance column. -->
    <bean name="shareableViewMetadataNames" class="java.util.ArrayList">
        <constructor-arg>
            <list>
                <value>storageId</value>
                <value>endTime</value>
                <value>duration</value>
                <value>name</value>
                <value>originId</value>
                <value>patientId</value>
                <value>correlationId</value>
                <value>status</value>
            </list>
        </constructor-arg>
    </bean>

    <!--
        Single storage model: ALL reports (including de-identified stubbed runs) live in the normal
        DatabaseDebugStorage. The Shareable view is just a filtered lens over that one storage —
        metadataFilter sharable=true shows only the de-identified copies and adds the originId column.
        No separate storage, no RoutingLogStorage. (parent + autowire="byName" mirrors the upstream
        "DifferentViewsDifferentColumns" pattern: inherit whiteBoxView, give it its own columns + filter.)
    -->
    <bean name="shareableView" parent="whiteBoxView" autowire="byName">
        <property name="name" value="Shareable (de-identified)"/>
        <property name="metadataNames" ref="shareableViewMetadataNames"/>
        <property name="metadataFilter">
            <map>
                <entry key="sharable" value="true"/>
            </map>
        </property>
    </bean>

    <bean name="views" class="org.wearefrank.ladybug.filter.Views">
        <property name="views">
            <list>
                <ref bean="whiteBoxView"/>
                <ref bean="grayBoxView"/>
                <ref bean="blackBoxView"/>
                <ref bean="shareableView"/>
            </list>
        </property>
    </bean>

    <!-- Override the debug log storage with a thin wrapper that fills the report description for
         de-identified shareable runs (from the sharable/originId session keys) at store time. -->
    <beans profile="ladybug-database">
        <bean name="debugStorage" class="com.viscosiety.ladybug.ShareableReportDescriber"
              autowire="byName" depends-on="ladybugDatabaseChangelog">
            <property name="name" value="DatabaseDebugStorage"/>
        </bean>
    </beans>
</beans>
