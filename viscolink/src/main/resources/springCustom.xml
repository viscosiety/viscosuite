<?xml version="1.0" encoding="UTF-8"?>
<!--
    F!F loads this file via SPRING.CONFIG.LOCATIONS in AppConstants.properties.
    It is merged into a child context of IbisApplicationContext after the initial refresh.

    FHIR servlet beans (R4FhirServlet, Dstu3FhirServlet, FhirFfBridge) are declared
    in springFhir.xml, which is registered via ViscoLinkModule.getSpringConfigurationFiles()
    so they participate in the main context refresh and are picked up by
    ServletRegisteringPostProcessor.

    Use this file for Ladybug / debugger customisation only.
-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
       ">
</beans>
