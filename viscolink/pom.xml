<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.visco</groupId>
	<artifactId>viscolink</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>war</packaging>

	<name>ViscoLink</name>

	<!--
		Note: frankframework-bundle-minimal cannot be used as a Maven parent for external
		projects because its published pom contains unresolved ${project.version} placeholders
		in dependencyManagement (the bundle is designed for use inside the F!F reactor only).
		Instead, we import frankframework-parent as a BOM — BOM imports evaluate properties
		in the BOM's own context, so ${project.version} correctly resolves to 9.4.1.
		All F!F module dependencies are then declared explicitly with ${frankframework.version}.
	-->

	<properties>
		<frankframework.version>10.2.0-20260516.042329</frankframework.version>
		<!-- Published from viscoSuiteDev branch at git.viscosiety.com/public-applications/ladybug.
		     Includes offset pagination support and postMessage bridge for ViscoFlow deep-link. -->
		<ladybug.version>4.1-SNAPSHOT</ladybug.version>
		<hapi.version>8.8.1</hapi.version>
		<log4j2.version>2.25.3</log4j2.version>
		<jboss-logging.version>3.6.1.Final</jboss-logging.version>
		<h2.version>2.4.240</h2.version>
		<junit.version>5.14.1</junit.version>
		<maven.compiler.source>21</maven.compiler.source>
		<maven.compiler.target>21</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<failOnMissingWebXml>false</failOnMissingWebXml>
	</properties>

	<dependencyManagement>
		<dependencies>
			<!--
				Importing frankframework-parent as a BOM gives us correct version management
				for all F!F transitive dependencies (Spring, Jackson, CXF, Jakarta APIs, etc.).
			-->
			<dependency>
				<groupId>org.frankframework</groupId>
				<artifactId>frankframework-parent</artifactId>
				<version>${frankframework.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<!--
				The F!F BOM pins junit-jupiter-engine and junit-jupiter-params to 6.0.3
				(JUnit 6), which conflicts with our JUnit 5 API jar.  Override here to
				keep all JUnit artifacts on 5.x.
			-->
			<dependency>
				<groupId>org.junit.jupiter</groupId>
				<artifactId>junit-jupiter-engine</artifactId>
				<version>${junit.version}</version>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>org.junit.jupiter</groupId>
				<artifactId>junit-jupiter-params</artifactId>
				<version>${junit.version}</version>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>org.junit.platform</groupId>
				<artifactId>junit-platform-engine</artifactId>
				<version>1.14.1</version>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>org.junit.platform</groupId>
				<artifactId>junit-platform-launcher</artifactId>
				<version>1.14.1</version>
				<scope>test</scope>
			</dependency>
			<!-- Force the ladybug fork (offset-pagination) over the newer official build.
			     Remove once wearefrank/ladybug#814 is merged and released. -->
			<dependency>
				<groupId>org.wearefrank</groupId>
				<artifactId>ladybug-common</artifactId>
				<version>${ladybug.version}</version>
			</dependency>
			<dependency>
				<groupId>org.wearefrank</groupId>
				<artifactId>ladybug-backend-springmvc</artifactId>
				<version>${ladybug.version}</version>
			</dependency>
			<dependency>
				<groupId>org.wearefrank</groupId>
				<artifactId>ladybug-frontend</artifactId>
				<version>${ladybug.version}</version>
			</dependency>
			<dependency>
				<groupId>org.wearefrank</groupId>
				<artifactId>ladybug-frontend-servlet</artifactId>
				<version>${ladybug.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<!-- Equivalent to frankframework-bundle-minimal, with explicit versions -->
		<dependency>
			<groupId>org.frankframework</groupId>
			<artifactId>frankframework-core</artifactId>
			<version>${frankframework.version}</version>
		</dependency>
		<dependency>
			<groupId>org.frankframework</groupId>
			<artifactId>frankframework-kubernetes</artifactId>
			<version>${frankframework.version}</version>
		</dependency>
		<dependency>
			<groupId>org.frankframework</groupId>
			<artifactId>frankframework-filesystem</artifactId>
			<version>${frankframework.version}</version>
		</dependency>
		<dependency>
			<groupId>org.frankframework</groupId>
			<artifactId>frankframework-larva</artifactId>
			<version>${frankframework.version}</version>
		</dependency>
		<dependency>
			<groupId>org.frankframework</groupId>
			<artifactId>frankframework-ladybug-debugger</artifactId>
			<version>${frankframework.version}</version>
		</dependency>
		<dependency>
			<groupId>org.frankframework</groupId>
			<artifactId>frankframework-console-frontend</artifactId>
			<version>${frankframework.version}</version>
		</dependency>
		<dependency>
			<groupId>org.frankframework</groupId>
			<artifactId>frankframework-console-backend</artifactId>
			<version>${frankframework.version}</version>
		</dependency>
		<dependency>
			<groupId>org.frankframework</groupId>
			<artifactId>frankframework-messaging</artifactId>
			<version>${frankframework.version}</version>
		</dependency>
		<!-- jakarta.jms-api is declared provided in the F!F BOM (expecting an EE container),
		     but Tomcat does not bundle JMS. Override to compile scope so the jar lands in
		     WEB-INF/lib and SpringJmsConnector can load from springJms.xml. -->
		<dependency>
			<groupId>jakarta.jms</groupId>
			<artifactId>jakarta.jms-api</artifactId>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>jakarta.servlet</groupId>
			<artifactId>jakarta.servlet-api</artifactId>
			<version>6.1.0</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.logging.log4j</groupId>
			<artifactId>log4j-web</artifactId>
			<version>${log4j2.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.jboss.logging</groupId>
			<artifactId>jboss-logging</artifactId>
			<version>${jboss-logging.version}</version>
			<scope>runtime</scope>
		</dependency>

		<!-- HAPI FHIR — server runtime and version-specific structures -->
		<dependency>
			<groupId>ca.uhn.hapi.fhir</groupId>
			<artifactId>hapi-fhir-server</artifactId>
			<version>${hapi.version}</version>
		</dependency>
		<dependency>
			<groupId>ca.uhn.hapi.fhir</groupId>
			<artifactId>hapi-fhir-structures-r4</artifactId>
			<version>${hapi.version}</version>
		</dependency>
		<dependency>
			<groupId>ca.uhn.hapi.fhir</groupId>
			<artifactId>hapi-fhir-structures-r5</artifactId>
			<version>${hapi.version}</version>
		</dependency>
		<dependency>
			<groupId>ca.uhn.hapi.fhir</groupId>
			<artifactId>hapi-fhir-structures-dstu3</artifactId>
			<version>${hapi.version}</version>
		</dependency>
		<dependency>
			<groupId>ca.uhn.hapi.fhir</groupId>
			<artifactId>hapi-fhir-validation-resources-dstu3</artifactId>
			<version>${hapi.version}</version>
		</dependency>
		<dependency>
			<groupId>ca.uhn.hapi.fhir</groupId>
			<artifactId>hapi-fhir-validation-resources-r4</artifactId>
			<version>${hapi.version}</version>
		</dependency>
		<dependency>
			<groupId>ca.uhn.hapi.fhir</groupId>
			<artifactId>hapi-fhir-validation-resources-r5</artifactId>
			<version>${hapi.version}</version>
		</dependency>
		<dependency>
			<groupId>ca.uhn.hapi.fhir</groupId>
			<artifactId>hapi-fhir-validation</artifactId>
			<version>${hapi.version}</version>
		</dependency>
		<dependency>
			<groupId>ca.uhn.hapi.fhir</groupId>
			<artifactId>hapi-fhir-caching-caffeine</artifactId>
			<version>${hapi.version}</version>
		</dependency>

		<!-- jakarta.activation-api is marked 'provided' in the F!F BOM but Tomcat does not supply it -->
		<dependency>
			<groupId>jakarta.activation</groupId>
			<artifactId>jakarta.activation-api</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- H2 for local development; PostgreSQL driver is provided at Tomcat level in production -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<version>${h2.version}</version>
			<scope>runtime</scope>
		</dependency>

		<!-- HAPI HL7v2 — pipe-delimited ↔ XML conversion in Hl7v2ToXmlPipe / XmlToHl7v2Pipe -->
		<dependency>
			<groupId>ca.uhn.hapi</groupId>
			<artifactId>hapi-base</artifactId>
			<version>2.5.1</version>
		</dependency>
		<!-- HL7v2 message structures for commonly used versions -->
		<dependency>
			<groupId>ca.uhn.hapi</groupId>
			<artifactId>hapi-structures-v23</artifactId>
			<version>2.5.1</version>
		</dependency>
		<dependency>
			<groupId>ca.uhn.hapi</groupId>
			<artifactId>hapi-structures-v24</artifactId>
			<version>2.5.1</version>
		</dependency>
		<dependency>
			<groupId>ca.uhn.hapi</groupId>
			<artifactId>hapi-structures-v25</artifactId>
			<version>2.5.1</version>
		</dependency>
		<dependency>
			<groupId>ca.uhn.hapi</groupId>
			<artifactId>hapi-structures-v251</artifactId>
			<version>2.5.1</version>
		</dependency>
		<dependency>
			<groupId>ca.uhn.hapi</groupId>
			<artifactId>hapi-structures-v26</artifactId>
			<version>2.5.1</version>
		</dependency>
		<dependency>
			<groupId>ca.uhn.hapi</groupId>
			<artifactId>hapi-structures-v27</artifactId>
			<version>2.5.1</version>
		</dependency>
		<dependency>
			<groupId>ca.uhn.hapi</groupId>
			<artifactId>hapi-structures-v28</artifactId>
			<version>2.5.1</version>
		</dependency>

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.14.0</version>
			</plugin>
			<!-- Extract F!F console index.html so we can patch it at build time -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>unpack-console-index</id>
						<phase>generate-resources</phase>
						<goals><goal>unpack</goal></goals>
						<configuration>
							<!-- overWriteSnapshots forces re-extraction from the current SNAPSHOT JAR on every
							     build so the patched index.html always matches the bundled JS asset hash. -->
							<overWriteSnapshots>true</overWriteSnapshots>
							<artifactItems>
								<artifactItem>
									<groupId>org.frankframework</groupId>
									<artifactId>frankframework-console-frontend</artifactId>
									<version>${frankframework.version}</version>
									<includes>console/index.html</includes>
									<outputDirectory>${project.build.directory}/console-original</outputDirectory>
								</artifactItem>
							</artifactItems>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- Inject <script src="fhir-webservices.js"> into the extracted index.html -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>3.1.0</version>
				<executions>
					<execution>
						<id>patch-console-index</id>
						<phase>prepare-package</phase>
						<goals><goal>run</goal></goals>
						<configuration>
							<target>
								<mkdir dir="${project.build.directory}/console-patched/console"/>
								<copy file="${project.build.directory}/console-original/console/index.html"
								      tofile="${project.build.directory}/console-patched/console/index.html"
								      overwrite="true"/>
								<replace file="${project.build.directory}/console-patched/console/index.html">
									<replacetoken><![CDATA[</body>]]></replacetoken>
									<replacevalue><![CDATA[<script src="fhir-webservices.js"></script></body>]]></replacevalue>
								</replace>
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- Redirect F!F's log directory to target/ during the build so the ff: lookup
			     fallback does not create a literal "${ff:log.dir}" folder in the source tree. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<systemPropertyVariables>
						<log.dir>${project.build.directory}/logs</log.dir>
					</systemPropertyVariables>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-war-plugin</artifactId>
				<version>3.5.1</version>
				<configuration>
					<failOnMissingWebXml>false</failOnMissingWebXml>
					<!-- Package WEB-INF/classes as a JAR so Frank!Framework's ComponentLoader
					     can open it as a ZipFile during module discovery. Without this,
					     Tomcat deploys an exploded WEB-INF/classes directory which F!F
					     tries to open as a ZipFile and fails with "Is a directory".
					     addDefaultImplementationEntries adds Implementation-Title and
					     Implementation-Version, which ModuleInformation requires. -->
					<archiveClasses>true</archiveClasses>
					<archive>
						<manifest>
							<addDefaultImplementationEntries>true</addDefaultImplementationEntries>
						</manifest>
					</archive>
					<!-- Place files at WEB-INF/classes/ so Tomcat's WebappClassLoader finds them
					     before any JAR in WEB-INF/lib/ (including frankframework-core-*.jar). -->
					<webResources>
						<resource>
							<directory>${project.build.directory}/console-patched</directory>
							<targetPath>WEB-INF/classes</targetPath>
						</resource>
					</webResources>
				</configuration>
			</plugin>
		</plugins>
	</build>
	<repositories>
		<repository>
			<id>frankframework</id>
			<name>Frank!Framework</name>
			<url>https://nexus.frankframework.org/content/repositories/public</url>
		</repository>
		<repository>
			<id>gitlab-ladybug</id>
			<url>https://git.viscosiety.com/api/v4/projects/6/packages/maven</url>
		</repository>
	</repositories>
</project>
