<?xml version="1.0" encoding="UTF-8"?>
<!--
  labObservationsWithoutCodes — Lab Observations with absent, incomplete, or non-standard coding.

  Showcase: real-world lab data quality problems that systems must handle gracefully.
  Each observation demonstrates a distinct coding deficiency:

    obs-nocodes-glucose    — code.text only; no coding element at all
    obs-nocodes-creat      — local hospital code only; no standard terminology
    obs-nocodes-potassium  — LOINC code present but display text absent
    obs-nocodes-sodium     — two conflicting codings (LOINC + local) with no text
    obs-nocodes-tsh        — no code element value at all (empty code)
    obs-nocodes-hba1c      — LOINC code present but value absent (dataAbsentReason: error)
-->
<Bundle xmlns="http://hl7.org/fhir">
  <id value="fixture-lab-observations-without-codes"/>
  <type value="transaction"/>

  <!-- ═══════════════════════ Patient ═══════════════════════ -->
  <entry>
    <fullUrl value="Patient/pat-lab-nocodes-001"/>
    <resource>
      <Patient>
        <id value="pat-lab-nocodes-001"/>
        <identifier>
          <system value="http://example.nl/fhir/NamingSystem/bsn"/>
          <value value="999900034"/>
        </identifier>
        <name>
          <family value="Jansen"/>
          <given value="Maria"/>
        </name>
        <gender value="female"/>
        <birthDate value="1975-11-08"/>
      </Patient>
    </resource>
    <request>
      <method value="PUT"/>
      <url value="Patient/pat-lab-nocodes-001"/>
    </request>
  </entry>

  <!-- ─────────────────────────────────────────────────────────────
       1. code.text ONLY — no coding element
          Glucose nuchter (fasting glucose).  The sending system exported only
          the free-text label; no LOINC or SNOMED code was included.
       ───────────────────────────────────────────────────────────── -->
  <entry>
    <fullUrl value="Observation/obs-nocodes-glucose-001"/>
    <resource>
      <Observation>
        <id value="obs-nocodes-glucose-001"/>
        <status value="final"/>
        <category>
          <coding>
            <system value="http://terminology.hl7.org/CodeSystem/observation-category"/>
            <code value="laboratory"/>
          </coding>
        </category>
        <code>
          <!-- No <coding> element — text only -->
          <text value="Glucose nuchter"/>
        </code>
        <subject>
          <reference value="Patient/pat-lab-nocodes-001"/>
        </subject>
        <effectiveDateTime value="2026-03-12T07:45:00+01:00"/>
        <valueQuantity>
          <value value="5.8"/>
          <unit value="mmol/L"/>
          <system value="http://unitsofmeasure.org"/>
          <code value="mmol/L"/>
        </valueQuantity>
        <referenceRange>
          <low><value value="3.9"/><unit value="mmol/L"/><system value="http://unitsofmeasure.org"/><code value="mmol/L"/></low>
          <high><value value="6.1"/><unit value="mmol/L"/><system value="http://unitsofmeasure.org"/><code value="mmol/L"/></high>
        </referenceRange>
      </Observation>
    </resource>
    <request>
      <method value="PUT"/>
      <url value="Observation/obs-nocodes-glucose-001"/>
    </request>
  </entry>

  <!-- ─────────────────────────────────────────────────────────────
       2. Local hospital code ONLY — no standard terminology
          Creatinine.  The LIS exports its internal catalogue code (system:
          http://lab.hospital-example.nl/codes) without mapping to LOINC.
       ───────────────────────────────────────────────────────────── -->
  <entry>
    <fullUrl value="Observation/obs-nocodes-creat-001"/>
    <resource>
      <Observation>
        <id value="obs-nocodes-creat-001"/>
        <status value="final"/>
        <category>
          <coding>
            <system value="http://terminology.hl7.org/CodeSystem/observation-category"/>
            <code value="laboratory"/>
          </coding>
        </category>
        <code>
          <coding>
            <!-- Non-standard local code; no LOINC equivalent included -->
            <system value="http://lab.hospital-example.nl/codes"/>
            <code value="CREA"/>
            <display value="Creatinine serum"/>
          </coding>
        </code>
        <subject>
          <reference value="Patient/pat-lab-nocodes-001"/>
        </subject>
        <effectiveDateTime value="2026-03-12T07:45:00+01:00"/>
        <valueQuantity>
          <value value="124"/>
          <unit value="umol/L"/>
          <system value="http://unitsofmeasure.org"/>
          <code value="umol/L"/>
        </valueQuantity>
        <interpretation>
          <coding>
            <system value="http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation"/>
            <code value="H"/>
            <display value="High"/>
          </coding>
        </interpretation>
        <referenceRange>
          <low><value value="45"/><unit value="umol/L"/><system value="http://unitsofmeasure.org"/><code value="umol/L"/></low>
          <high><value value="110"/><unit value="umol/L"/><system value="http://unitsofmeasure.org"/><code value="umol/L"/></high>
        </referenceRange>
      </Observation>
    </resource>
    <request>
      <method value="PUT"/>
      <url value="Observation/obs-nocodes-creat-001"/>
    </request>
  </entry>

  <!-- ─────────────────────────────────────────────────────────────
       3. LOINC code present but display text absent
          Potassium.  The coding system and code are correct but the display
          field was not populated, leaving it blank.
       ───────────────────────────────────────────────────────────── -->
  <entry>
    <fullUrl value="Observation/obs-nocodes-potassium-001"/>
    <resource>
      <Observation>
        <id value="obs-nocodes-potassium-001"/>
        <status value="final"/>
        <category>
          <coding>
            <system value="http://terminology.hl7.org/CodeSystem/observation-category"/>
            <code value="laboratory"/>
          </coding>
        </category>
        <code>
          <coding>
            <system value="http://loinc.org"/>
            <code value="2823-3"/>
            <!-- display intentionally absent -->
          </coding>
        </code>
        <subject>
          <reference value="Patient/pat-lab-nocodes-001"/>
        </subject>
        <effectiveDateTime value="2026-03-12T07:45:00+01:00"/>
        <valueQuantity>
          <value value="3.3"/>
          <unit value="mmol/L"/>
          <system value="http://unitsofmeasure.org"/>
          <code value="mmol/L"/>
        </valueQuantity>
        <interpretation>
          <coding>
            <system value="http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation"/>
            <code value="L"/>
            <display value="Low"/>
          </coding>
        </interpretation>
        <referenceRange>
          <low><value value="3.5"/><unit value="mmol/L"/><system value="http://unitsofmeasure.org"/><code value="mmol/L"/></low>
          <high><value value="5.0"/><unit value="mmol/L"/><system value="http://unitsofmeasure.org"/><code value="mmol/L"/></high>
        </referenceRange>
      </Observation>
    </resource>
    <request>
      <method value="PUT"/>
      <url value="Observation/obs-nocodes-potassium-001"/>
    </request>
  </entry>

  <!-- ─────────────────────────────────────────────────────────────
       4. Two conflicting codings, no code.text
          Sodium.  The message contains both a LOINC code and a local code,
          no display text on either, and no code.text fallback.  Consumers
          must pick one coding without a text hint.
       ───────────────────────────────────────────────────────────── -->
  <entry>
    <fullUrl value="Observation/obs-nocodes-sodium-001"/>
    <resource>
      <Observation>
        <id value="obs-nocodes-sodium-001"/>
        <status value="final"/>
        <category>
          <coding>
            <system value="http://terminology.hl7.org/CodeSystem/observation-category"/>
            <code value="laboratory"/>
          </coding>
        </category>
        <code>
          <coding>
            <system value="http://loinc.org"/>
            <code value="2951-2"/>
            <!-- display absent -->
          </coding>
          <coding>
            <system value="http://lab.hospital-example.nl/codes"/>
            <code value="NA"/>
            <!-- display absent -->
          </coding>
          <!-- no code.text -->
        </code>
        <subject>
          <reference value="Patient/pat-lab-nocodes-001"/>
        </subject>
        <effectiveDateTime value="2026-03-12T07:45:00+01:00"/>
        <valueQuantity>
          <value value="141"/>
          <unit value="mmol/L"/>
          <system value="http://unitsofmeasure.org"/>
          <code value="mmol/L"/>
        </valueQuantity>
        <referenceRange>
          <low><value value="136"/><unit value="mmol/L"/><system value="http://unitsofmeasure.org"/><code value="mmol/L"/></low>
          <high><value value="145"/><unit value="mmol/L"/><system value="http://unitsofmeasure.org"/><code value="mmol/L"/></high>
        </referenceRange>
      </Observation>
    </resource>
    <request>
      <method value="PUT"/>
      <url value="Observation/obs-nocodes-sodium-001"/>
    </request>
  </entry>

  <!-- ─────────────────────────────────────────────────────────────
       5. Empty code — no system, no code, no text
          TSH.  The source system transmitted a result with a completely empty
          <code> element; the test identity is unknown from the message alone.
       ───────────────────────────────────────────────────────────── -->
  <entry>
    <fullUrl value="Observation/obs-nocodes-tsh-001"/>
    <resource>
      <Observation>
        <id value="obs-nocodes-tsh-001"/>
        <status value="final"/>
        <category>
          <coding>
            <system value="http://terminology.hl7.org/CodeSystem/observation-category"/>
            <code value="laboratory"/>
          </coding>
        </category>
        <code>
          <!-- Completely empty code — no coding, no text -->
        </code>
        <subject>
          <reference value="Patient/pat-lab-nocodes-001"/>
        </subject>
        <effectiveDateTime value="2026-03-12T07:45:00+01:00"/>
        <valueQuantity>
          <value value="3.12"/>
          <unit value="mIU/L"/>
          <system value="http://unitsofmeasure.org"/>
          <code value="m[IU]/L"/>
        </valueQuantity>
        <referenceRange>
          <low><value value="0.35"/><unit value="mIU/L"/><system value="http://unitsofmeasure.org"/><code value="m[IU]/L"/></low>
          <high><value value="4.94"/><unit value="mIU/L"/><system value="http://unitsofmeasure.org"/><code value="m[IU]/L"/></high>
        </referenceRange>
      </Observation>
    </resource>
    <request>
      <method value="PUT"/>
      <url value="Observation/obs-nocodes-tsh-001"/>
    </request>
  </entry>

  <!-- ─────────────────────────────────────────────────────────────
       6. Code present but value absent — dataAbsentReason: error
          HbA1c.  The analyser reported an instrument error; the LOINC code
          identifies the test but no numeric result is available.
       ───────────────────────────────────────────────────────────── -->
  <entry>
    <fullUrl value="Observation/obs-nocodes-hba1c-001"/>
    <resource>
      <Observation>
        <id value="obs-nocodes-hba1c-001"/>
        <status value="final"/>
        <category>
          <coding>
            <system value="http://terminology.hl7.org/CodeSystem/observation-category"/>
            <code value="laboratory"/>
          </coding>
        </category>
        <code>
          <coding>
            <system value="http://loinc.org"/>
            <code value="4548-4"/>
            <display value="Hemoglobin A1c/Hemoglobin.total in Blood"/>
          </coding>
          <text value="HbA1c"/>
        </code>
        <subject>
          <reference value="Patient/pat-lab-nocodes-001"/>
        </subject>
        <effectiveDateTime value="2026-03-12T07:45:00+01:00"/>
        <!-- No value[x] — replaced by dataAbsentReason -->
        <dataAbsentReason>
          <coding>
            <system value="http://terminology.hl7.org/CodeSystem/data-absent-reason"/>
            <code value="error"/>
            <display value="Error"/>
          </coding>
          <text value="Analyser fout — resultaat niet beschikbaar"/>
        </dataAbsentReason>
        <note>
          <text value="Instrument error code E-412 reported during analysis. Sample requires re-run."/>
        </note>
      </Observation>
    </resource>
    <request>
      <method value="PUT"/>
      <url value="Observation/obs-nocodes-hba1c-001"/>
    </request>
  </entry>

</Bundle>
