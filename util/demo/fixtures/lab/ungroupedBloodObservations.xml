  <entry>
    <fullUrl value="Patient/pat-lab-ungrouped-001"/>
    <resource>
      <Patient>
        <id value="pat-lab-ungrouped-001"/>
        <identifier>
          <system value="http://example.nl/fhir/NamingSystem/bsn"/>
          <value value="999900012"/>
        </identifier>
        <name>
          <family value="de Vries"/>
          <given value="Jan"/>
        </name>
        <gender value="male"/>
        <birthDate value="1968-05-23"/>
      </Patient>
    </resource>
    <request>
      <method value="PUT"/>
      <url value="Patient/pat-lab-ungrouped-001"/>
    </request>
  </entry>

