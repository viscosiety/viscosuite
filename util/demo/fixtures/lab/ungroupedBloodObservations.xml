<?xml version="1.0" encoding="UTF-8"?>
<!--
  ungroupedBloodObservations — Complete Blood Count (CBC) as eight standalone Observations.

  Showcase: a full CBC where each result is an independent Observation resource with no
  hasMember grouping and no parent DiagnosticReport.  The pattern stresses FHIR viewers
  and analytics pipelines that rely on grouping to display a coherent result panel.

  Clinical pattern: normocytic anaemia (low Hgb/Ht/RBC, normal MCV/MCH/MCHC) with
  reactive leukocytosis and thrombocytosis — plausible e.g. after acute blood loss.
-->
<Bundle xmlns="http://hl7.org/fhir">
  <id value="fixture-ungrouped-blood-observations"/>
  <type value="transaction"/>

