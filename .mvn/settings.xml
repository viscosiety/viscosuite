<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">

  <!-- CI reads every artifact through Viscosiety's Maven proxy on the NAS (Reposilite,
       viscoFoundry docs/ops/maven-proxy.md): one repository that knows where each group comes from
       (org.frankframework from the Frank!Framework mirror, com.visco from this project's registry,
       the rest from Maven Central and Frank!Framework's Nexus) and keeps what it fetched. Reachable
       from the LAN only, so this file is for CI; a local build does not use it. Publishing is not
       affected: distributionManagement does not go through mirrors. -->
  <mirrors>
    <mirror>
      <id>viscosiety-maven</id>
      <mirrorOf>*</mirrorOf>
      <url>https://maven.viscosiety.com/maven</url>
    </mirror>
  </mirrors>

  <profiles>
    <profile>
      <id>frankframework-nexus</id>
      <repositories>
        <repository>
          <id>frankframework-public</id>
          <url>https://nexus.frankframework.org/content/groups/public</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>true</enabled></snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>frankframework-public-plugins</id>
          <url>https://nexus.frankframework.org/content/groups/public</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>true</enabled></snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>

  <servers>
    <!-- The GitLab Maven package registry takes the job token as a header (no username). -->
    <server>
      <id>gitlab-maven</id>
      <configuration>
        <httpHeaders>
          <property>
            <name>Job-Token</name>
            <value>${env.CI_JOB_TOKEN}</value>
          </property>
        </httpHeaders>
      </configuration>
    </server>
  </servers>

  <activeProfiles>
    <activeProfile>frankframework-nexus</activeProfile>
  </activeProfiles>

</settings>
